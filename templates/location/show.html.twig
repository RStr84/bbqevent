{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }}
    Details

{% endblock %}

{% block content %}
    <div>
        Die Location beinhaltet folgende Locationdaten:<br>
        <br>
        Name: {{ location.name }}<br>
        Kapazität: {{ location.capacity }}<br>
        Adresse: {{ location.address }}<br>
        E-Mail: {{ location.email }}<br>

        {% if location.events %}
{#            <div class="alert alert-warning">#}
{#                Diese Location kann nicht gelöscht werden, da noch Events vorhanden sind!!!#}
{#            </div>#}
        Events:
            {% for event in location.events %}
                <li>
                    <a href="{{ path('app_event_show', {'id': event.id}) }}">{{ event.name }}</a>
                </li>
            {% endfor %}
        {% endif %}
        <br>

        <a class='btn-primary btn' href='{{ path('app_location_edit', {id: location.id}) }}'>Edit</a>
        <a class='btn-danger btn' href='{{ path('app_location_delete', {id: location.id}) }}'>Delete</a>
    </div>
{% endblock %}