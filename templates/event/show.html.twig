{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }}
    Details
    
{% endblock %}

{% block content %}
    <div>
        Das Event beinhaltet folgende Eventdaten:<br>
        <br>
        Name: {{ event.name }}<br>
        Eventtyp: {{ event.eventType.value ??'' }}<br>
        Beschreibung: {{ event.description }}<br>
        Gebuchte Plätze: {{ event.bookedSeats }}<br>
        Location: <a href="{{ path('app_location_show', {id: event.location.id}) }}">{{ event.location.name }}</a><br>
        <br>

        <a class='btn-primary btn' href='{{ path('app_event_edit', {id: event.id}) }}'>Edit</a>
        <a class='btn-danger btn' href='{{ path('app_event_delete', {id: event.id}) }}'>Delete</a>
    </div>
{% endblock %}